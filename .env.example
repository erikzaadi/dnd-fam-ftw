# Persistence
PERSISTENCE_PROVIDER=sqlite
SQLITE_DB_PATH=./data/dnd-fam-ftw.sqlite

# Image storage
IMAGE_STORAGE_PROVIDER=local
LOCAL_IMAGE_STORAGE_PATH=./data/generated-images
LOCAL_IMAGE_PUBLIC_BASE_URL=/api/generated

# S3 image storage (only needed when IMAGE_STORAGE_PROVIDER=s3)
# AWS_REGION=eu-west-1
# S3_IMAGE_BUCKET=fam-dnd-ftw-images
# S3_IMAGE_PREFIX=generated/
# S3_IMAGE_PUBLIC_BASE_URL=https://images.fam-dnd-ftw.erikzaadi.com

# Frontend build vars (set these in CI/CD environment or .env.production for AWS builds)
# VITE_BASE_PATH defaults to '/' for dev and AWS. Set to '/dnd-fam-ftw/' only for local laptop builds (scripts/re-deploy.sh).
# VITE_API_BASE_URL=https://api.fam-dnd-ftw.erikzaadi.com  # backend origin for cross-domain; leave unset for local dev

# Auth
# APP_BASE_PATH defaults to '/'. Set to '/dnd-fam-ftw/' if running the app at a subpath.
# GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback
# FRONTEND_URL=http://localhost:5173

# OpenAI-compatible AI
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL_NARRATION=gpt-4.1-mini
# OPENAI_MODEL_PREVIEW=gpt-5.6-luna
# OPENAI_MODEL_ASYNC=gpt-4.1
# OPENAI_IMAGE_MODEL=gpt-image-2
# Preview-tier reasoning_effort: none|minimal|low|medium|high|xhigh, or omit.
# Unset sends "none" (the built-in default, paired with the built-in gpt-5.6-luna preview model).
# "omit" never sends the field: set it for custom endpoints or models that reject reasoning_effort.
# Invalid values stop startup.
# OPENAI_REASONING_EFFORT_PREVIEW=
# Client-wide SDK retry count. Unset keeps the OpenAI SDK default (2).
# Live evaluation scripts require OPENAI_MAX_RETRIES=0 so every request counts against their budget.
# OPENAI_MAX_RETRIES=

# Auth
# AUTH_MODE=disabled|enabled. Unset: "enabled" if any of GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET, or JWT_SECRET is set, otherwise "disabled" (local namespace,
# no login). With auth enabled, incomplete settings stop startup instead of
# silently disabling login.
# AUTH_MODE=
# SIGNUP_MODE=invite_only|open (default invite_only)
# SIGNUP_MODE=
# Max new self-service accounts per UTC day (default 25)
# SIGNUP_DAILY_CAP=
# Email sign-in codes and signup notices: none (default) | ses | capture (dev: prints mail to the log)
# EMAIL_PROVIDER=capture
# EMAIL_FROM="DnD Fam FTW <no-reply@mail.example.com>"
# SES_REGION=
# EMAIL_CODE_HMAC_SECRET=
# SIGNUP_NOTIFY_EMAIL=
# Browser origin allowed for credentialed requests (plus any localhost origin outside production)
# FRONTEND_URL=
# GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# Usage cost estimates (USD per 1M tokens) for models missing from the built-in table
# USAGE_MODEL_PRICES={"gpt-image-2":{"input":5,"output":40}}

# Usage limits. Global estimated AI spend per UTC day (unset = no global limit)
# DAILY_SPEND_LIMIT_USD=3
# Donation page behind "Support the realm" in Your Realm (https; unset hides the button)
# SUPPORT_URL=https://ko-fi.com/yourname
# Ko-fi webhook token (Ko-fi > Settings > API). Enables POST /webhooks/kofi: a payment from a
# player's sign-in email makes their group a supporter for 90 days. Unset disables the webhook.
# KOFI_VERIFICATION_TOKEN=
# Per-tier overrides (null = unlimited)
# USAGE_TIER_LIMITS={"free":{"textCreditsPerDay":150,"picturesPerDay":20}}

# Google OAuth credentials
# SESSION_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# JWT_SECRET=
